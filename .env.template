PORT=8080
HOST=0.0.0.0
DB_PATH=./data/meeteasier.db
LOG_LEVEL=info

# Initial Admin Account (seeded only when database is created)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Optional static Bearer token for /api/admin/* automation scripts
ADMIN_API_TOKEN=
# Optional HMAC secret for admin session cookies (auto-generated in SQLite if omitted)
SESSION_SECRET=

# Optional bootstrap for initial default tenant (can also be configured in /admin)
OAUTH_CLIENT_ID=
OAUTH_AUTHORITY=
OAUTH_CLIENT_SECRET=
DOMAIN=example.com

# Optional automated theme/tenant provisioning on startup (Docker / Kubernetes)
# BOOTSTRAP_THEME_FILE=/app/bootstrap/theme.json
# BOOTSTRAP_DIR=/app/bootstrap
# BOOTSTRAP_THEME_JSON=

SEARCH_MAXDAYS=10
SEARCH_MAXROOMLISTS=10
SEARCH_MAXROOMS=20
SEARCH_MAXITEMS=6
POLL_INTERVAL=60
