MEETEASIER_PORT=8080
MEETEASIER_HOST=0.0.0.0
MEETEASIER_DB_PATH=./data/meeteasier.db
MEETEASIER_LOG_LEVEL=info
MEETEASIER_STATIC_DIR=static
# Optional explicit config file path (yaml, json, toml, or env) - supports live hot-reload
# MEETEASIER_CONFIG_FILE=./meeteasier.yaml

# Initial Admin Account (seeded only when database is created)
MEETEASIER_ADMIN_USERNAME=admin
MEETEASIER_ADMIN_PASSWORD=admin123
# Optional static Bearer token for /api/admin/* automation scripts (hot-reloadable via config file)
MEETEASIER_ADMIN_API_TOKEN=
# Optional HMAC secret for admin session cookies (auto-generated in SQLite if omitted)
MEETEASIER_SESSION_SECRET=

# Optional bootstrap for initial default tenant (can also be configured in /admin)
# Unprefixed OAUTH_* / DOMAIN / SEARCH_* variables are also supported as fallback.
MEETEASIER_OAUTH_CLIENT_ID=
MEETEASIER_OAUTH_AUTHORITY=
MEETEASIER_OAUTH_CLIENT_SECRET=
MEETEASIER_DOMAIN=example.com

# Optional automated theme/tenant provisioning on startup (Docker / Kubernetes)
# MEETEASIER_BOOTSTRAP_THEME_FILE=/app/bootstrap/theme.json
# MEETEASIER_BOOTSTRAP_DIR=/app/bootstrap
# MEETEASIER_BOOTSTRAP_THEME_JSON=

MEETEASIER_SEARCH_MAXDAYS=10
MEETEASIER_SEARCH_MAXROOMLISTS=10
MEETEASIER_SEARCH_MAXROOMS=20
MEETEASIER_SEARCH_MAXITEMS=6
MEETEASIER_POLL_INTERVAL=60
