package singleroom

import (
	"fmt"
	"net/url"
	"strconv"
	"strings"
	"time"

	"github.com/probits-as/meeteasier/internal/i18n"
	"github.com/probits-as/meeteasier/internal/model"
	"github.com/probits-as/meeteasier/views/layout"
)

func singleRoomPartialURL(alias, tenantSlug string, explicitTenant bool) string {
	return appendTenantQuery("/partials/single-room/"+url.PathEscape(alias), tenantSlug, explicitTenant)
}

func singleRoomBookURL(alias, tenantSlug string, explicitTenant bool) string {
	return appendTenantQuery("/single-room/"+url.PathEscape(alias)+"/book", tenantSlug, explicitTenant)
}

func appendTenantQuery(path, tenantSlug string, explicitTenant bool) string {
	if explicitTenant && tenantSlug != "" {
		return path + "?tenant=" + url.QueryEscape(tenantSlug)
	}
	return path
}

func formatSingleRoomTime(startMs, endMs int64) string {
	s := time.UnixMilli(startMs).Local()
	e := time.UnixMilli(endMs).Local()
	return fmt.Sprintf("%s - %s", s.Format("02 Mon 15:04"), e.Format("Mon 15:04"))
}

func nextUpLabel(labels model.ThemeLabels, busy bool) string {
	if busy {
		return ""
	}
	if strings.TrimSpace(labels.NextUp) != "" {
		return labels.NextUp + ": "
	}
	return ""
}

templ SingleRoomPage(tenant model.Tenant, room model.Room, alias string, found bool, initialized bool, explicitTenant bool, tr i18n.Translations, flashMsg string, errMsg string) {
	@layout.Base(roomTitle(tenant, room, alias, found), tenant, tr) {
		<div
			id="single-room__wrap"
			hx-get={ singleRoomPartialURL(alias, tenant.Slug, explicitTenant) }
			hx-trigger="every 30s [!document.activeElement || !document.activeElement.closest('.sr-booking-panel')]"
			hx-swap="innerHTML"
		>
			@SingleRoomContent(tenant, room, found, initialized, explicitTenant, tr, flashMsg, errMsg)
		</div>
	}
}

func roomTitle(tenant model.Tenant, room model.Room, alias string, found bool) string {
	if found && room.Name != "" {
		return room.Name + " - " + tenant.Name
	}
	return alias + " - " + tenant.Name
}

templ SingleRoomContent(tenant model.Tenant, room model.Room, found bool, initialized bool, explicitTenant bool, tr i18n.Translations, flashMsg string, errMsg string) {
	if !initialized && !found {
		<p id="fb__spinner-wrap">
			<img id="fb__spinner" alt={ tr.LoadingAlt } src="/svgs/spinner.svg"/>
		</p>
	} else if !found {
		<div id="error-wrap">
			<div id="error-text">
				<div id="error-header">{ tr.SingleRoomErrorTitle }</div>
				{ tr.SingleRoomErrorBody }
			</div>
		</div>
	} else {
		<div class="row expanded full-height">
			<div class={ "columns small-8 left-col", templ.KV("busy", room.Busy), templ.KV("open", !room.Busy) }>
				<div id="single-room__room-name">{ room.Name }</div>
				<div id="single-room__room-status">
					if room.Busy {
						{ tr.EffectiveLabels(tenant.Theme).StatusBusy }
					} else {
						{ tr.EffectiveLabels(tenant.Theme).StatusAvailable }
					}
				</div>
				<div id="single-room__details">
					if len(room.Appointments) > 0 {
						<div id="single-room__meeting-title">
							<span id="single-room__next-up">{ nextUpLabel(tr.EffectiveLabels(tenant.Theme), room.Busy) }</span>
							<span id="single-room__meeting-subject">{ room.Appointments[0].Subject }</span>
						</div>
					}
				</div>
				<div
					id="single-room__meeting-time"
					if len(room.Appointments) > 0 {
						data-start-ms={ strconv.FormatInt(room.Appointments[0].Start, 10) }
						data-end-ms={ strconv.FormatInt(room.Appointments[0].End, 10) }
						data-show-weekday="true"
					}
				>
					if len(room.Appointments) > 0 {
						{ formatSingleRoomTime(room.Appointments[0].Start, room.Appointments[0].End) }
					}
				</div>
				<div id="single-room__meeting-organizer">
					if len(room.Appointments) > 0 {
						{ room.Appointments[0].Organizer }
					}
				</div>
				if tenant.BookingEnabled && room.ErrorMessage == "" {
					@bookingPanel(tenant, room, explicitTenant, tr, flashMsg, errMsg)
				}
			</div>
			<div class="columns small-4 right-col">
				<div id="single-room__clock-wrap">
					<div id="single-room__clock">
						<div id="single-room__time">{ time.Now().Format("15:04") }</div>
						<div id="single-room__date">{ time.Now().Format("January 02") }</div>
					</div>
				</div>
				<div id="upcoming-title">{ tr.EffectiveLabels(tenant.Theme).UpcomingTitle }</div>
				<table>
					if len(room.Appointments) > 1 {
						for _, appt := range room.Appointments[1:] {
							<tr>
								<td class="up__meeting-title">{ appt.Subject }</td>
								<td
									class="up__meeting-time"
									width="44%"
									data-start-ms={ strconv.FormatInt(appt.Start, 10) }
									data-end-ms={ strconv.FormatInt(appt.End, 10) }
									data-show-weekday="true"
								>
									if appt.Start > 0 && appt.End > 0 {
										{ formatSingleRoomTime(appt.Start, appt.End) }
									}
								</td>
							</tr>
						}
					}
				</table>
				if strings.TrimSpace(tenant.Theme.SingleRoomLogoURL) != "" {
					<div id="logo">
						<img src={ tenant.Theme.SingleRoomLogoURL } alt={ tenant.Name + " logo" }/>
					</div>
				}
			</div>
		</div>
	}
}

templ bookingPanel(tenant model.Tenant, room model.Room, explicitTenant bool, tr i18n.Translations, flashMsg string, errMsg string) {
	<div class="sr-booking-panel">
		if flashMsg != "" {
			<div class="sr-booking-alert ok">{ flashMsg }</div>
		}
		if errMsg != "" {
			<div class="sr-booking-alert err">{ errMsg }</div>
		}
		<form
			method="post"
			action={ templ.SafeURL(singleRoomBookURL(room.RoomAlias, tenant.Slug, explicitTenant)) }
			hx-post={ singleRoomBookURL(room.RoomAlias, tenant.Slug, explicitTenant) }
			hx-target="#single-room__wrap"
			hx-swap="innerHTML"
		>
			if !room.Busy {
				if durations := model.AvailableBookingDurations(room, false, time.Now()); len(durations) > 0 {
					<div class="sr-booking-inputs">
						<input class="sr-input" type="text" name="subject" placeholder={ tr.SubjectPlaceholder } autocomplete="off"/>
						if tenant.HasBookingPIN {
							<input class="sr-input sr-input-pin" type="password" name="pin" inputmode="numeric" placeholder={ tr.PINPlaceholder } required autocomplete="off"/>
						}
					</div>
					<div class="sr-booking-group">
						<span class="sr-booking-label">{ tr.BookNowLabel }</span>
						<div class="sr-booking-buttons">
							for _, mins := range durations {
								<button type="submit" name="booking_choice" value={ fmt.Sprintf("%s:%d", model.BookingActionBookNow, mins) } class="sr-book-btn">
									{ strconv.Itoa(mins) } { tr.MinSuffix }
								</button>
							}
						</div>
					</div>
				} else {
					<div class="sr-booking-note">{ tr.RoomSoonBusyLabel }</div>
				}
			} else if len(room.Appointments) > 0 {
				if afterDurations := model.AvailableBookingDurations(room, true, time.Now()); len(afterDurations) > 0 || tenant.HasBookingPIN {
					<div class="sr-booking-inputs">
						if len(afterDurations) > 0 {
							<input class="sr-input" type="text" name="subject" placeholder={ tr.BookAfterSubjectPlaceholder } autocomplete="off"/>
						}
						if tenant.HasBookingPIN {
							<input class="sr-input sr-input-pin" type="password" name="pin" inputmode="numeric" placeholder={ tr.PINPlaceholder } required autocomplete="off"/>
						}
					</div>
				}
				<div class="sr-booking-group">
					<span class="sr-booking-label">{ tr.CurrentMeetingLabel }</span>
					<div class="sr-booking-buttons">
						<button type="submit" name="booking_choice" value={ fmt.Sprintf("%s:0", model.BookingActionEndNow) } class="sr-book-btn sr-book-btn-danger">
							{ tr.EndNowButton }
						</button>
						for _, mins := range model.AvailableBookingDurations(room, true, time.Now()) {
							<button type="submit" name="booking_choice" value={ fmt.Sprintf("%s:%d", model.BookingActionExtend, mins) } class="sr-book-btn">
								{ fmt.Sprintf(tr.ExtendFmt, mins) }
							</button>
						}
					</div>
				</div>
				if afterDurations := model.AvailableBookingDurations(room, true, time.Now()); len(afterDurations) > 0 {
					<div class="sr-booking-group">
						<span class="sr-booking-label">{ tr.BookAfterLabel }</span>
						<div class="sr-booking-buttons">
							for _, mins := range afterDurations {
								<button type="submit" name="booking_choice" value={ fmt.Sprintf("%s:%d", model.BookingActionBookAfter, mins) } class="sr-book-btn sr-book-btn-secondary">
									{ strconv.Itoa(mins) } { tr.MinSuffix }
								</button>
							}
						</div>
					</div>
				}
			}
		</form>
	</div>
}

