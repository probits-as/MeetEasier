package layout

import (
	"fmt"
	"regexp"
	"strings"

	"github.com/probits-as/meeteasier/internal/i18n"
	"github.com/probits-as/meeteasier/internal/model"
)

var unsafeCSSValueRe = regexp.MustCompile(`[^a-zA-Z0-9#(),.\-%\s]`)
var closingStyleRe = regexp.MustCompile(`(?i)</\s*style`)

func sanitizeCSSVal(val, fallback string) string {
	v := strings.TrimSpace(val)
	if v == "" {
		return fallback
	}
	cleaned := unsafeCSSValueRe.ReplaceAllString(v, "")
	if cleaned == "" {
		return fallback
	}
	return cleaned
}

func sanitizeCustomCSS(css string) string {
	return closingStyleRe.ReplaceAllString(css, "")
}

func buildThemeCSS(t model.Tenant) string {
	th := t.Theme
	std := model.DefaultStandardTheme()
	sb := strings.Builder{}
	sb.WriteString("<style id=\"tenant-theme-vars\">:root{\n")
	sb.WriteString(fmt.Sprintf("  --body-bg:%s;\n", sanitizeCSSVal(th.BodyBg, std.BodyBg)))
	sb.WriteString(fmt.Sprintf("  --card-bg:%s;\n", sanitizeCSSVal(th.CardBg, std.CardBg)))
	sb.WriteString(fmt.Sprintf("  --card-border:%s;\n", sanitizeCSSVal(th.CardBorder, std.CardBorder)))
	sb.WriteString(fmt.Sprintf("  --title-bar-bg:%s;\n", sanitizeCSSVal(th.TitleBarBg, std.TitleBarBg)))
	sb.WriteString(fmt.Sprintf("  --primary-font:%s;\n", sanitizeCSSVal(th.PrimaryFont, std.PrimaryFont)))
	sb.WriteString(fmt.Sprintf("  --open-color:%s;\n", sanitizeCSSVal(th.OpenColor, std.OpenColor)))
	sb.WriteString(fmt.Sprintf("  --open-dark-color:%s;\n", sanitizeCSSVal(th.OpenDarkColor, std.OpenDarkColor)))
	sb.WriteString(fmt.Sprintf("  --busy-color:%s;\n", sanitizeCSSVal(th.BusyColor, std.BusyColor)))
	sb.WriteString(fmt.Sprintf("  --upcoming-color:%s;\n", sanitizeCSSVal(th.UpcomingColor, std.UpcomingColor)))
	sb.WriteString(fmt.Sprintf("  --error-color:%s;\n", sanitizeCSSVal(th.ErrorColor, std.ErrorColor)))
	sb.WriteString(fmt.Sprintf("  --single-room-status-size:%s;\n", sanitizeCSSVal(th.SingleRoomStatusFontSize, std.SingleRoomStatusFontSize)))
	sb.WriteString("}</style>\n")
	if strings.TrimSpace(t.CustomCSS) != "" {
		sb.WriteString("<style id=\"tenant-custom-css\">\n")
		sb.WriteString(sanitizeCustomCSS(t.CustomCSS))
		sb.WriteString("\n</style>\n")
	}
	return sb.String()
}

templ Base(title string, tenant model.Tenant, tr i18n.Translations) {
	<!doctype html>
	<html lang={ tr.LangCode }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no"/>
			<title>{ title }</title>
			<link rel="shortcut icon" href="/favicon.ico"/>
			<link href="https://fonts.googleapis.com/css?family=Titillium+Web:100,300,400,600,700" rel="stylesheet"/>
			<link rel="stylesheet" href="/css/styles.css"/>
			@templ.Raw(buildThemeCSS(tenant))
			<script src="/js/htmx.min.js" defer></script>
		</head>
		<body data-locale={ tr.Locale } data-hour12={ fmt.Sprintf("%t", !tr.Use24Hour(tenant.Theme)) }>
			{ children... }
			<script>
				(function () {
					function activeLocale() {
						return (document.body && document.body.getAttribute('data-locale')) || undefined;
					}

					function isHour12() {
						return Boolean(document.body && document.body.getAttribute('data-hour12') === 'true');
					}

					function updateClocks() {
						var now = new Date();
						var loc = activeLocale();
						var h12 = isHour12();
						var hourFmt = h12 ? 'numeric' : '2-digit';
						var fbClock = document.getElementById('clock');
						if (fbClock) {
							fbClock.textContent = now.toLocaleTimeString(loc, { hour: hourFmt, minute: '2-digit', second: '2-digit', hour12: h12 });
						}
						var srTime = document.getElementById('single-room__time');
						if (srTime) {
							srTime.textContent = now.toLocaleTimeString(loc, { hour: hourFmt, minute: '2-digit', hour12: h12 });
						}
						var srDate = document.getElementById('single-room__date');
						if (srDate) {
							srDate.textContent = now.toLocaleDateString(loc, { month: 'long', day: '2-digit' });
						}
					}

					function formatTimes() {
						var loc = activeLocale();
						var h12 = isHour12();
						var hourFmt = h12 ? 'numeric' : '2-digit';
						var els = document.querySelectorAll('[data-start-ms][data-end-ms]');
						for (var i = 0; i < els.length; i++) {
							var el = els[i];
							var start = parseInt(el.getAttribute('data-start-ms'), 10);
							var end = parseInt(el.getAttribute('data-end-ms'), 10);
							if (!start || !end) continue;
							var showWeekday = el.getAttribute('data-show-weekday') === 'true';
							var sDate = new Date(start);
							var eDate = new Date(end);
							if (showWeekday) {
								el.textContent =
									sDate.toLocaleTimeString(loc, { day: '2-digit', weekday: 'short', hour: hourFmt, minute: '2-digit', hour12: h12 }) +
									' - ' +
									eDate.toLocaleTimeString(loc, { weekday: 'short', hour: hourFmt, minute: '2-digit', hour12: h12 });
							} else {
								el.textContent =
									sDate.toLocaleTimeString(loc, { hour: hourFmt, minute: '2-digit', hour12: h12 }) +
									' - ' +
									eDate.toLocaleTimeString(loc, { hour: hourFmt, minute: '2-digit', hour12: h12 });
							}
						}
					}

					function bindDropdown() {
						var filterRoot = document.getElementById('roomlist-filter');
						if (!filterRoot) return;
						var toggle = filterRoot.querySelector('.current-filter');
						var parentLi = toggle ? toggle.parentElement : null;
						if (toggle && parentLi && !toggle.dataset.bound) {
							toggle.dataset.bound = '1';
							toggle.addEventListener('click', function (e) {
								e.preventDefault();
								parentLi.classList.toggle('is-open');
							});
						}
					}

					document.addEventListener('click', function (e) {
						var filterRoot = document.getElementById('roomlist-filter');
						if (filterRoot && !filterRoot.contains(e.target)) {
							var open = filterRoot.querySelector('.is-open');
							if (open) open.classList.remove('is-open');
						}
					});

					document.addEventListener('DOMContentLoaded', function () {
						updateClocks();
						formatTimes();
						bindDropdown();
						setInterval(updateClocks, 1000);
					});

					document.addEventListener('htmx:afterSwap', function () {
						formatTimes();
						bindDropdown();
					});
				})();
			</script>
		</body>
	</html>
}

templ AccessDeniedPage(tenant model.Tenant, clientIP string, tr i18n.Translations) {
	@Base(tenant.Name+" - "+tr.IPBlockedPageTitle, tenant, tr) {
		<div style="min-height:100vh; display:flex; align-items:center; justify-content:center; padding:2rem;">
			<div style="max-width:560px; width:100%; background:var(--card-bg, #333333); border:2px solid var(--busy-color, #f04124); border-radius:12px; padding:2.5rem 2rem; text-align:center; color:var(--primary-font, #ffffff); box-shadow:0 12px 32px rgba(0,0,0,0.45);">
				if strings.TrimSpace(tenant.Theme.LogoURL) != "" {
					<div style="margin-bottom:1.25rem;">
						<img src={ tenant.Theme.LogoURL } alt={ tenant.Name } style="max-height:56px; max-width:220px;"/>
					</div>
				}
				<div style="display:inline-flex; align-items:center; justify-content:center; width:56px; height:56px; border-radius:50%; background:rgba(240,65,36,0.18); color:var(--busy-color, #f04124); margin-bottom:1rem;">
					<svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor" aria-hidden="true">
						<path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 6c1.4 0 2.5 1.1 2.5 2.5V11c.55 0 1 .45 1 1v4c0 .55-.45 1-1 1h-5c-.55 0-1-.45-1-1v-4c0-.55.45-1 1-1V9.5C9.5 8.1 10.6 7 12 7zm0 1.5c-.55 0-1 .45-1 1V11h2V9.5c0-.55-.45-1-1-1z"></path>
					</svg>
				</div>
				<h1 style="font-size:1.65rem; font-weight:700; margin:0 0 0.75rem 0; color:var(--primary-font, #ffffff);">{ tr.IPBlockedHeading }</h1>
				<p style="font-size:1.08rem; line-height:1.5; margin:0 0 1.25rem 0; opacity:0.92;">{ tr.IPBlockedMessage }</p>
				<div style="display:inline-block; padding:0.45rem 0.9rem; border-radius:6px; background:rgba(0,0,0,0.3); border:1px solid var(--card-border, #474747); font-family:ui-monospace, SFMono-Regular, Menlo, monospace; font-size:0.9rem; opacity:0.85;">
					{ fmt.Sprintf(tr.IPBlockedClientIPFmt, clientIP) }
				</div>
			</div>
		</div>
	}
}

