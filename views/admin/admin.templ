package admin

import (
	"fmt"
	"strings"

	"github.com/probits-as/meeteasier/internal/i18n"
	"github.com/probits-as/meeteasier/internal/model"
)

func safePickerHex(raw string) string {
	s := strings.TrimSpace(raw)
	if len(s) == 7 && strings.HasPrefix(s, "#") {
		return s
	}
	return "#333333"
}

func effectiveAdminPlaceholders(t model.Tenant, adminTr i18n.Translations) model.ThemeLabels {
	if lang := i18n.NormalizeTenantLanguage(t.Language); lang != "" {
		return i18n.For(lang).PlaceholderLabels()
	}
	return adminTr.PlaceholderLabels()
}

templ labelOverrideField(label, name, val, curPH, sysPH, enPH, nbPH string) {
	<div class="adm-field">
		<label>{ label }</label>
		<input
			type="text"
			name={ name }
			value={ val }
			placeholder={ curPH }
			data-ph-sys={ sysPH }
			data-ph-en={ enPH }
			data-ph-nb={ nbPH }
		/>
	</div>
}

templ section5LabelFields(t model.Tenant, tr i18n.Translations, curPH, sysPH, enPH, nbPH model.ThemeLabels) {
	@labelOverrideField(tr.LabelNavbarTitle, "label_navbar_title", t.Theme.Labels.NavbarTitle, curPH.NavbarTitle, sysPH.NavbarTitle, enPH.NavbarTitle, nbPH.NavbarTitle)
	@labelOverrideField(tr.LabelFilterTitle, "label_filter_title", t.Theme.Labels.FilterTitle, curPH.FilterTitle, sysPH.FilterTitle, enPH.FilterTitle, nbPH.FilterTitle)
	@labelOverrideField(tr.LabelFilterAllTitle, "label_filter_all_title", t.Theme.Labels.FilterAllTitle, curPH.FilterAllTitle, sysPH.FilterAllTitle, enPH.FilterAllTitle, nbPH.FilterAllTitle)
	@labelOverrideField(tr.LabelStatusAvailable, "label_status_available", t.Theme.Labels.StatusAvailable, curPH.StatusAvailable, sysPH.StatusAvailable, enPH.StatusAvailable, nbPH.StatusAvailable)
	@labelOverrideField(tr.LabelStatusBusy, "label_status_busy", t.Theme.Labels.StatusBusy, curPH.StatusBusy, sysPH.StatusBusy, enPH.StatusBusy, nbPH.StatusBusy)
	@labelOverrideField(tr.LabelStatusError, "label_status_error", t.Theme.Labels.StatusError, curPH.StatusError, sysPH.StatusError, enPH.StatusError, nbPH.StatusError)
	@labelOverrideField(tr.LabelNowPrefix, "label_now_prefix", t.Theme.Labels.NowPrefix, curPH.NowPrefix, sysPH.NowPrefix, enPH.NowPrefix, nbPH.NowPrefix)
	@labelOverrideField(tr.LabelNextUp, "label_next_up", t.Theme.Labels.NextUp, curPH.NextUp, sysPH.NextUp, enPH.NextUp, nbPH.NextUp)
	@labelOverrideField(tr.LabelUpcomingTitle, "label_upcoming_title", t.Theme.Labels.UpcomingTitle, curPH.UpcomingTitle, sysPH.UpcomingTitle, enPH.UpcomingTitle, nbPH.UpcomingTitle)
}

templ colorField(label string, name string, val string) {
	<div class="adm-field">
		<label>{ label }</label>
		<div class="adm-color-input">
			<input type="color" value={ safePickerHex(val) } oninput="this.nextElementSibling.value=this.value"/>
			<input type="text" name={ name } value={ val } oninput="if(/^#[0-9a-fA-F]{6}$/.test(this.value)){this.previousElementSibling.value=this.value}"/>
		</div>
	</div>
}

templ AdminLoginPage(errMsg string, tr i18n.Translations) {
	<!DOCTYPE html>
	<html lang={ tr.LangCode }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ tr.AdminLoginPageTitle }</title>
			<link rel="stylesheet" href="/css/admin.css"/>
		</head>
		<body class="admin-body">
			<div class="adm-login-wrap">
				<div class="adm-login-card">
					<div style="display:flex; justify-content:space-between; align-items:center; gap:0.75rem; margin-bottom:0.5rem;">
						<h2 style="margin:0;">{ tr.AdminHeader }</h2>
						<form method="get" action="/admin/login" style="margin:0;">
							<select name="lang" class="adm-lang-select" aria-label={ tr.LanguageLabel } onchange="this.form.submit()">
								for _, opt := range i18n.SupportedLanguages() {
									<option value={ opt.Code } selected?={ opt.Code == tr.LangCode }>{ opt.Name }</option>
								}
							</select>
						</form>
					</div>
					<p class="adm-hint">{ tr.LoginSubtitle }</p>
					if errMsg != "" {
						<div class="adm-alert err">{ errMsg }</div>
					}
					<form method="post" action="/admin/login">
						<div class="adm-field">
							<label for="username">{ tr.UsernameLabel }</label>
							<input id="username" type="text" name="username" required autofocus/>
						</div>
						<div class="adm-field" style="margin-top:0.85rem;">
							<label for="password">{ tr.PasswordLabel }</label>
							<input id="password" type="password" name="password" required/>
						</div>
						<div style="margin-top:1.25rem;">
							<button type="submit" class="adm-btn adm-btn-primary" style="width:100%;">{ tr.LoginButton }</button>
						</div>
					</form>
				</div>
			</div>
		</body>
	</html>
}

templ AdminDashboardPage(
	tenants []model.Tenant,
	statuses map[int64]model.TenantStatus,
	selected *model.Tenant,
	flash string,
	errMsg string,
	adminUser string,
	tr i18n.Translations,
) {
	<!DOCTYPE html>
	<html lang={ tr.LangCode }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ tr.AdminDashboardPageTitle }</title>
			<link rel="stylesheet" href="/css/admin.css"/>
		</head>
		<body class="admin-body">
			<header class="adm-topbar">
				<h1>{ tr.AdminHeader }</h1>
				<div class="adm-topbar-right">
					<form method="post" action="/admin/language" style="display:flex; align-items:center; gap:0.45rem; margin:0;">
						if selected != nil {
							<input type="hidden" name="tenant_id" value={ fmt.Sprintf("%d", selected.ID) }/>
						}
						<label for="adm-global-lang" class="adm-hint" style="margin:0;">{ tr.LanguageLabel }:</label>
						<select id="adm-global-lang" name="language" class="adm-lang-select" onchange="this.form.submit()">
							for _, opt := range i18n.SupportedLanguages() {
								<option value={ opt.Code } selected?={ opt.Code == tr.LangCode }>{ opt.Name }</option>
							}
						</select>
					</form>
					<span>{ tr.LoggedInAs } <strong>{ adminUser }</strong></span>
					<a href="/" target="_blank" class="adm-btn">{ tr.OpenDefaultView }</a>
					<form method="post" action="/admin/logout" style="margin:0;">
						<button type="submit" class="adm-btn">{ tr.Logout }</button>
					</form>
				</div>
			</header>
			<div class="adm-layout">
				<aside>
					<div class="adm-card">
						<h2>{ tr.TenantsHeading }</h2>
						<ul class="adm-tenant-list">
							for _, t := range tenants {
								@tenantSidebarItem(t, statuses[t.ID], selected != nil && selected.ID == t.ID, tr)
							}
						</ul>
					</div>
					<div class="adm-card">
						<h3>{ tr.CreateTenantHeading }</h3>
						<form method="post" action="/admin/tenants">
							<div class="adm-field">
								<label>{ tr.DisplayNameLabel }</label>
								<input type="text" name="name" placeholder={ tr.DisplayNamePlaceholder } required/>
							</div>
							<div class="adm-field" style="margin-top:0.65rem;">
								<label>{ tr.SlugLabel }</label>
								<input type="text" name="slug" placeholder={ tr.SlugPlaceholder }/>
							</div>
							<div class="adm-field" style="margin-top:0.65rem;">
								<label>{ tr.CustomDomainsLabel }</label>
								<input type="text" name="domains" placeholder={ tr.CustomDomainsPlaceholder }/>
							</div>
							<div class="adm-field" style="margin-top:0.65rem;">
								<label>{ tr.PresetLabel }</label>
								<select name="theme_preset">
									<option value={ model.PresetStandard }>{ tr.PresetStandardOption }</option>
									<option value={ model.PresetCompact }>{ tr.PresetCompactOption }</option>
								</select>
							</div>
							<div style="margin-top:0.9rem;">
								<button type="submit" class="adm-btn adm-btn-primary" style="width:100%;">{ tr.CreateTenantButton }</button>
							</div>
						</form>
					</div>
					<div class="adm-card">
						<h3>{ tr.ImportTenantHeading }</h3>
						<p class="adm-hint">{ tr.ImportTenantHint }</p>
						<form method="post" action="/admin/tenants/import" enctype="multipart/form-data">
							<div class="adm-field">
								<label>{ tr.ChooseJSONFile }</label>
								<input type="file" name="theme_file" accept=".json,application/json" required/>
							</div>
							<div style="margin-top:0.85rem;">
								<button type="submit" class="adm-btn" style="width:100%;">{ tr.ImportTenantButton }</button>
							</div>
						</form>
					</div>
					<div class="adm-card">
						<h3>{ tr.ChangePasswordHeading }</h3>
						<form method="post" action="/admin/password">
							<div class="adm-field">
								<label>{ tr.NewPasswordLabel }</label>
								<input type="password" name="new_password" minlength="6" required/>
							</div>
							<div style="margin-top:0.85rem;">
								<button type="submit" class="adm-btn" style="width:100%;">{ tr.UpdatePasswordButton }</button>
							</div>
						</form>
					</div>
				</aside>
				<main>
					if flash != "" {
						<div class="adm-alert ok">{ flash }</div>
					}
					if errMsg != "" {
						<div class="adm-alert err">{ errMsg }</div>
					}
					if selected == nil {
						<div class="adm-card">
							<p>{ tr.SelectTenantPrompt }</p>
						</div>
					} else {
						@tenantEditor(*selected, statuses[selected.ID], tr)
					}
				</main>
			</div>
		</body>
	</html>
}

templ tenantSidebarItem(t model.Tenant, st model.TenantStatus, active bool, tr i18n.Translations) {
	<li class={ "adm-tenant-item", templ.KV("active", active) }>
		<a href={ templ.SafeURL(fmt.Sprintf("/admin?tenant_id=%d", t.ID)) }>
			<div><strong>{ t.Name }</strong></div>
			<div class="adm-tenant-meta">
				<span>{ t.Slug }</span>
				<span class="adm-badge">{ fmt.Sprintf(tr.RoomsCountFmt, len(st.Rooms)) }</span>
				if t.IsDefault {
					<span class="adm-badge ok">{ tr.DefaultBadge }</span>
				}
				if st.IsStale {
					<span class="adm-badge warn">{ tr.StaleCacheBadge }</span>
				}
				if st.LastError != "" {
					<span class="adm-badge err">{ tr.ErrorBadge }</span>
				}
			</div>
		</a>
	</li>
}

templ tenantEditor(t model.Tenant, st model.TenantStatus, tr i18n.Translations) {
	<div class="adm-card">
		<div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem;">
			<div>
				<h2 style="margin-bottom:0.25rem;">{ t.Name } <span class="adm-badge">{ t.Slug }</span></h2>
				<p class="adm-hint" style="margin:0;">
					<strong>{ tr.SyncStatusLabel }:</strong> { fmt.Sprintf(tr.SyncStatusCountsFmt, len(st.Rooms), len(st.Roomlists)) }
					<span> · </span>
					if !st.LastSync.IsZero() {
						{ fmt.Sprintf(tr.LastUpdatedFmt, st.LastSync.Format("2006-01-02 15:04:05")) }
					} else {
						{ tr.NotSyncedYet }
					}
				</p>
			</div>
			<div class="adm-btn-row">
				<a href={ templ.SafeURL(fmt.Sprintf("/?tenant=%s", t.Slug)) } target="_blank" class="adm-btn">{ tr.PreviewNoDNS }</a>
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/tenants/%d/sync", t.ID)) } style="margin:0;">
					<button type="submit" class="adm-btn adm-btn-primary">{ tr.TestAndSyncNow }</button>
				</form>
				<form
					method="post"
					action={ templ.SafeURL(fmt.Sprintf("/admin/tenants/%d/delete", t.ID)) }
					data-confirm={ tr.DeleteTenantConfirm }
					onsubmit="return confirm(this.getAttribute('data-confirm'));"
					style="margin:0;"
				>
					<button type="submit" class="adm-btn adm-btn-danger">{ tr.DeleteTenant }</button>
				</form>
			</div>
		</div>
		if st.LastError != "" {
			<div class="adm-alert err" style="margin-top:0.85rem;">
				<strong>{ tr.LastErrorLabel }:</strong> { st.LastError }
			</div>
		}
		if st.IsStale {
			<div class="adm-alert" style="margin-top:0.85rem; border:1px solid var(--adm-warn); background:rgba(245,158,11,0.12); color:#fde68a;">
				{ tr.StaleCacheHint }
			</div>
		}
		<div style="margin-top:1rem; padding-top:1rem; border-top:1px solid var(--adm-border);">
			<div class="adm-btn-row">
				<span class="adm-hint" style="margin-right:0.25rem;">{ tr.QuickPresetTitle }:</span>
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/tenants/%d/preset", t.ID)) } style="margin:0;">
					<input type="hidden" name="preset" value={ model.PresetStandard }/>
					<button type="submit" class="adm-btn">{ tr.LoadStandardTheme }</button>
				</form>
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/tenants/%d/preset", t.ID)) } style="margin:0;">
					<input type="hidden" name="preset" value={ model.PresetCompact }/>
					<button type="submit" class="adm-btn">{ tr.LoadCompactTheme }</button>
				</form>
				<a href={ templ.SafeURL(fmt.Sprintf("/admin/tenants/%d/theme-export", t.ID)) } class="adm-btn">{ tr.ExportThemeJSON }</a>
			</div>
			<p class="adm-hint" style="margin:0.45rem 0 0;">{ tr.PresetOverwriteHint }</p>
			<details style="margin-top:0.75rem;">
				<summary class="adm-btn" style="display:inline-flex;">{ tr.ImportThemeSummary }</summary>
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/tenants/%d/theme-import", t.ID)) } enctype="multipart/form-data" style="margin-top:0.85rem;">
					<div class="adm-field">
						<label>{ tr.ThemeFileLabel }</label>
						<input type="file" name="theme_file" accept=".json,application/json"/>
					</div>
					<label class="adm-checkbox">
						<input type="checkbox" name="include_metadata" value="1"/>
						{ tr.IncludeMetadataLabel }
					</label>
					<div class="adm-field" style="margin-top:0.65rem;">
						<label>{ tr.PasteJSONLabel }</label>
						<textarea name="theme_json" placeholder="{ ... }"></textarea>
					</div>
					<div style="margin-top:0.75rem;">
						<button type="submit" class="adm-btn adm-btn-primary">{ tr.ImportThemeButton }</button>
					</div>
				</form>
			</details>
		</div>
	</div>
	<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/tenants/%d", t.ID)) } enctype="multipart/form-data" class="adm-card">
		<h3 class="adm-section-title" style="margin-top:0;">{ tr.Sec1Title }</h3>
		<div class="adm-form-grid">
			<div class="adm-field">
				<label>{ tr.DisplayNameLabel }</label>
				<input type="text" name="name" value={ t.Name } required/>
			</div>
			<div class="adm-field">
				<label>{ tr.SlugHintLabel }</label>
				<input type="text" name="slug" value={ t.Slug } required/>
			</div>
			<div class="adm-field full">
				<label>{ tr.CustomDomainsEditLabel }</label>
				<input type="text" name="domains" value={ t.Domains } placeholder={ tr.CustomDomainsPlaceholder2 }/>
				<span class="adm-hint">{ tr.DomainsHint }</span>
			</div>
			<div class="adm-field">
				<label>{ tr.PollIntervalLabel }</label>
				<input type="number" name="poll_interval_seconds" min="10" value={ fmt.Sprintf("%d", t.PollIntervalSeconds) }/>
			</div>
			<div class="adm-field">
				<label>{ tr.TenantLanguageLabel }</label>
				<select
					name="language"
					onchange="var v=this.value||'sys';document.querySelectorAll('[data-ph-sys]').forEach(function(el){el.placeholder=el.getAttribute('data-ph-'+v)||el.getAttribute('data-ph-sys');});"
				>
					<option value="" selected?={ t.Language == "" }>{ tr.LangSystemDefaultOption }</option>
					for _, opt := range i18n.SupportedLanguages() {
						<option value={ opt.Code } selected?={ opt.Code == t.Language }>{ opt.Name }</option>
					}
				</select>
			</div>
			<div class="adm-field full">
				<label class="adm-checkbox">
					<input type="checkbox" name="is_default" value="1" checked?={ t.IsDefault }/>
					{ tr.DefaultTenantCheckbox }
				</label>
			</div>
		</div>
		<h3 class="adm-section-title">{ tr.Sec2Title }</h3>
		<div class="adm-form-grid">
			<div class="adm-field">
				<label>{ tr.CalendarProviderLabel }</label>
				<select name="provider_type">
					<option value={ model.ProviderMock } selected?={ t.ProviderType != model.ProviderMSGraph }>{ tr.ProviderMockOption }</option>
					<option value={ model.ProviderMSGraph } selected?={ t.ProviderType == model.ProviderMSGraph }>{ tr.ProviderMSGraphOption }</option>
				</select>
			</div>
			<div class="adm-field">
				<label>{ tr.PrivacyModeLabel }</label>
				<select name="privacy_mode">
					<option value={ model.PrivacyNormal } selected?={ t.PrivacyMode == model.PrivacyNormal }>{ tr.PrivacyNormalOption }</option>
					<option value={ model.PrivacyOrganizerAsSubject } selected?={ t.PrivacyMode == model.PrivacyOrganizerAsSubject }>{ tr.PrivacyOrgAsSubjOption }</option>
					<option value={ model.PrivacyHideSubject } selected?={ t.PrivacyMode == model.PrivacyHideSubject }>{ tr.PrivacyHideOption }</option>
				</select>
			</div>
			<div class="adm-field">
				<label>{ tr.OAuthClientIDLabel }</label>
				<input type="text" name="oauth_client_id" value={ t.OAuthClientID } placeholder={ tr.OAuthClientIDPlaceholder }/>
			</div>
			<div class="adm-field">
				<label>{ tr.OAuthAuthorityLabel }</label>
				<input type="text" name="oauth_authority" value={ t.OAuthAuthority }/>
			</div>
			<div class="adm-field">
				<label>
					{ tr.OAuthSecretLabel }
					if t.HasClientSecret {
						<span class="adm-badge ok" style="margin-left:0.35rem;">{ tr.SavedBadge }</span>
					}
				</label>
				<input type="password" name="oauth_client_secret" placeholder={ tr.OAuthSecretPlaceholder }/>
			</div>
			<div class="adm-field">
				<label>{ tr.ExchangeDomainLabel }</label>
				<input type="text" name="exchange_domain" value={ t.ExchangeDomain }/>
			</div>
			<div class="adm-field">
				<label>{ tr.MaxDaysLabel }</label>
				<input type="number" name="max_days" min="1" value={ fmt.Sprintf("%d", t.MaxDays) }/>
			</div>
			<div class="adm-field">
				<label>{ tr.MaxRoomListsLabel }</label>
				<input type="number" name="max_room_lists" min="1" value={ fmt.Sprintf("%d", t.MaxRoomLists) }/>
			</div>
			<div class="adm-field">
				<label>{ tr.MaxRoomsLabel }</label>
				<input type="number" name="max_rooms" min="1" value={ fmt.Sprintf("%d", t.MaxRooms) }/>
			</div>
			<div class="adm-field">
				<label>{ tr.MaxItemsLabel }</label>
				<input type="number" name="max_items" min="1" value={ fmt.Sprintf("%d", t.MaxItems) }/>
			</div>
			<div class="adm-field full">
				<label>{ tr.RoomBlacklistLabel }</label>
				<textarea name="room_blacklist">{ t.RoomBlacklist }</textarea>
			</div>
		</div>
		<h3 class="adm-section-title">{ tr.Sec2bTitle }</h3>
		<div class="adm-form-grid">
			<div class="adm-field full">
				<label class="adm-checkbox">
					<input type="checkbox" name="booking_enabled" value="1" checked?={ t.BookingEnabled }/>
					{ tr.BookingEnabledLabel }
				</label>
			</div>
			<div class="adm-field">
				<label>
					{ tr.BookingPINLabel }
					if t.HasBookingPIN {
						<span class="adm-badge ok" style="margin-left:0.35rem;">{ tr.BookingPINActiveBadge }</span>
					}
				</label>
				<input type="password" name="booking_pin" placeholder={ tr.BookingPINPlaceholder }/>
				<label class="adm-checkbox">
					<input type="checkbox" name="clear_booking_pin" value="1"/>
					{ tr.ClearBookingPINLabel }
				</label>
			</div>
			<div class="adm-field">
				<label>{ tr.BookingDefaultSubjectLabel }</label>
				<input type="text" name="booking_default_subject" value={ t.BookingDefaultSubject }/>
			</div>
			<div class="adm-field full">
				<label>{ tr.BookingOrganizerLabel }</label>
				<input type="text" name="booking_organizer_email" value={ t.BookingOrganizerEmail }/>
				<span class="adm-hint">{ tr.BookingOrganizerHint }</span>
			</div>
		</div>
		<h3 class="adm-section-title">{ tr.Sec3Title }</h3>
		<div class="adm-form-grid">
			<div class="adm-field">
				<label>{ tr.RowLayoutLabel }</label>
				<select name="row_layout">
					<option value={ model.RowLayoutStandard } selected?={ t.Theme.RowLayout != model.RowLayoutCompact }>{ tr.RowLayoutStandardOption }</option>
					<option value={ model.RowLayoutCompact } selected?={ t.Theme.RowLayout == model.RowLayoutCompact }>{ tr.RowLayoutCompactOption }</option>
				</select>
			</div>
			<div class="adm-field">
				<label>{ tr.SingleRoomStatusSizeLabel }</label>
				<input type="text" name="single_room_status_font_size" value={ t.Theme.SingleRoomStatusFontSize }/>
			</div>
			<div class="adm-field full">
				<label class="adm-checkbox">
					<input type="checkbox" name="show_weekday_in_time" value="1" checked?={ t.Theme.ShowWeekdayInTime }/>
					{ tr.ShowWeekdayInTimeLabel }
				</label>
			</div>
			<div class="adm-field full">
				<label>{ tr.TimeFormatLabel }</label>
				<select name="time_format">
					<option value="" selected?={ t.Theme.TimeFormat == "" }>{ tr.TimeFormatAutoOption }</option>
					<option value={ model.TimeFormat24H } selected?={ t.Theme.TimeFormat == model.TimeFormat24H }>{ tr.TimeFormat24HOption }</option>
					<option value={ model.TimeFormat12H } selected?={ t.Theme.TimeFormat == model.TimeFormat12H }>{ tr.TimeFormat12HOption }</option>
				</select>
			</div>
			<div class="adm-field">
				<label>{ tr.NavbarLogoLabel }</label>
				<input type="text" name="logo_url" value={ t.Theme.LogoURL }/>
				<input type="file" name="logo_file" accept="image/*" style="margin-top:0.35rem;"/>
				if t.Theme.LogoURL != "" {
					<img src={ t.Theme.LogoURL } alt="Navbar Logo" class="adm-asset-preview"/>
				}
			</div>
			<div class="adm-field">
				<label>{ tr.FooterBannerLabel }</label>
				<input type="text" name="footer_image_url" value={ t.Theme.FooterImageURL }/>
				<input type="file" name="footer_file" accept="image/*" style="margin-top:0.35rem;"/>
				if t.Theme.FooterImageURL != "" {
					<img src={ t.Theme.FooterImageURL } alt="Footer Banner" class="adm-asset-preview"/>
				}
			</div>
			<div class="adm-field">
				<label>{ tr.SingleRoomLogoLabel }</label>
				<input type="text" name="single_room_logo_url" value={ t.Theme.SingleRoomLogoURL }/>
				<input type="file" name="singleroom_logo_file" accept="image/*" style="margin-top:0.35rem;"/>
				if t.Theme.SingleRoomLogoURL != "" {
					<img src={ t.Theme.SingleRoomLogoURL } alt="Single-Room Logo" class="adm-asset-preview"/>
				}
			</div>
		</div>
		<h3 class="adm-section-title">{ tr.Sec4Title }</h3>
		<div class="adm-form-grid-3">
			@colorField(tr.ColorBodyBg, "body_bg", t.Theme.BodyBg)
			@colorField(tr.ColorCardBg, "card_bg", t.Theme.CardBg)
			@colorField(tr.ColorCardBorder, "card_border", t.Theme.CardBorder)
			@colorField(tr.ColorTitleBarBg, "title_bar_bg", t.Theme.TitleBarBg)
			@colorField(tr.ColorPrimaryFont, "primary_font", t.Theme.PrimaryFont)
			@colorField(tr.ColorOpen, "open_color", t.Theme.OpenColor)
			@colorField(tr.ColorOpenDark, "open_dark_color", t.Theme.OpenDarkColor)
			@colorField(tr.ColorBusy, "busy_color", t.Theme.BusyColor)
			@colorField(tr.ColorUpcoming, "upcoming_color", t.Theme.UpcomingColor)
			@colorField(tr.ColorError, "error_color", t.Theme.ErrorColor)
		</div>
		<h3 class="adm-section-title">{ tr.Sec5Title }</h3>
		<p class="adm-hint" style="margin-top:-0.35rem; margin-bottom:0.85rem;">{ tr.Sec5Hint }</p>
		<div class="adm-form-grid-3">
			@section5LabelFields(
				t,
				tr,
				effectiveAdminPlaceholders(t, tr),
				tr.PlaceholderLabels(),
				i18n.For(i18n.LangEnglish).PlaceholderLabels(),
				i18n.For(i18n.LangNorwegian).PlaceholderLabels(),
			)
		</div>
		<h3 class="adm-section-title">{ tr.Sec6Title }</h3>
		<div class="adm-field">
			<label>{ tr.CustomCSSLabel }</label>
			<textarea name="custom_css">{ t.CustomCSS }</textarea>
		</div>
		<div style="margin-top:1.25rem; display:flex; justify-content:flex-end;">
			<button type="submit" class="adm-btn adm-btn-primary">{ tr.SaveChangesButton }</button>
		</div>
	</form>
}
