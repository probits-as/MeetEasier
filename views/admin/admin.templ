package admin

import (
	"fmt"
	"strconv"
	"strings"

	"github.com/probits-as/meeteasier/internal/model"
)

func idStr(id int64) string {
	return strconv.FormatInt(id, 10)
}

func firstRoomAlias(st model.TenantStatus) string {
	if len(st.Rooms) > 0 && st.Rooms[0].RoomAlias != "" {
		return st.Rooms[0].RoomAlias
	}
	return "fjord"
}

templ AdminLayout(title string, adminUser string) {
	<!doctype html>
	<html lang="nb">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="shortcut icon" href="/favicon.ico"/>
			<link rel="stylesheet" href="/css/admin.css"/>
		</head>
		<body class="admin-body">
			if adminUser != "" {
				<header class="adm-topbar">
					<div>
						<h1>MeetEasier Admin</h1>
					</div>
					<div class="adm-topbar-right">
						<span>Innlogget som <strong>{ adminUser }</strong></span>
						<a href="/" target="_blank" class="adm-btn">Åpne standardvisning</a>
						<form method="post" action="/admin/logout" style="margin:0;">
							<button type="submit" class="adm-btn">Logg ut</button>
						</form>
					</div>
				</header>
			}
			{ children... }
		</body>
	</html>
}

templ AdminLoginPage(errMsg string) {
	@AdminLayout("Logg inn - MeetEasier Admin", "") {
		<div class="adm-login-wrap">
			<div class="adm-login-card">
				<h2 style="margin-top:0;">MeetEasier Admin</h2>
				<p class="adm-hint" style="margin-bottom:1.25rem;">
					Logg inn for å konfigurere tenants, custom domener, Microsoft Graph og utseende.
				</p>
				if errMsg != "" {
					<div class="adm-alert err">{ errMsg }</div>
				}
				<form method="post" action="/admin/login">
					<div class="adm-field" style="margin-bottom:1rem;">
						<label for="username">Brukernavn</label>
						<input id="username" name="username" type="text" required autofocus value="admin"/>
					</div>
					<div class="adm-field" style="margin-bottom:1.25rem;">
						<label for="password">Passord</label>
						<input id="password" name="password" type="password" required/>
					</div>
					<button type="submit" class="adm-btn adm-btn-primary" style="width:100%;">Logg inn</button>
				</form>
			</div>
		</div>
	}
}

templ AdminDashboardPage(
	tenants []model.Tenant,
	statuses map[int64]model.TenantStatus,
	selected *model.Tenant,
	flash string,
	errMsg string,
	adminUser string,
) {
	@AdminLayout("Tenants - MeetEasier Admin", adminUser) {
		<main class="adm-layout">
			<aside>
				<div class="adm-card">
					<h2>Tenants ({ strconv.Itoa(len(tenants)) })</h2>
					<ul class="adm-tenant-list">
						for _, t := range tenants {
							<li class={ "adm-tenant-item", templ.KV("active", selected != nil && selected.ID == t.ID) }>
								<a href={ templ.SafeURL("/admin?tenant_id=" + idStr(t.ID)) }>
									<div><strong>{ t.Name }</strong></div>
									<div class="adm-tenant-meta">
										<span>/{ t.Slug }</span>
										if t.IsDefault {
											<span class="adm-badge ok">Default</span>
										}
										<span class="adm-badge">{ t.ProviderType }</span>
										if st, ok := statuses[t.ID]; ok {
											if st.LastError != "" && st.IsStale {
												<span class="adm-badge warn">Stale cache</span>
											} else if st.LastError != "" {
												<span class="adm-badge err">Feil</span>
											} else if st.Initialized {
												<span class="adm-badge ok">{ strconv.Itoa(len(st.Rooms)) } rom</span>
											}
										}
									</div>
									if strings.TrimSpace(t.Domains) != "" {
										<div class="adm-hint" style="margin-top:0.25rem;">{ t.Domains }</div>
									}
								</a>
							</li>
						}
					</ul>
				</div>

				<div class="adm-card">
					<h3>Opprett ny tenant</h3>
					<form method="post" action="/admin/tenants">
						<div class="adm-field" style="margin-bottom:0.75rem;">
							<label for="new-name">Visningsnavn</label>
							<input id="new-name" name="name" type="text" placeholder="F.eks. Demo Bedrift AS" required/>
						</div>
						<div class="adm-field" style="margin-bottom:0.75rem;">
							<label for="new-slug">Slug</label>
							<input id="new-slug" name="slug" type="text" placeholder="demo-bedrift"/>
						</div>
						<div class="adm-field" style="margin-bottom:0.75rem;">
							<label for="new-domains">Custom domener (kommaseparert)</label>
							<input id="new-domains" name="domains" type="text" placeholder="moterom.demo.no"/>
						</div>
						<div class="adm-field" style="margin-bottom:1rem;">
							<label for="new-preset">Start-tema (Preset)</label>
							<select id="new-preset" name="theme_preset">
								<option value="standard">Standard (MeetEasier)</option>
								<option value="compact">Kompakt (2-kolonne, norsk, klikkbar rad)</option>
							</select>
						</div>
						<button type="submit" class="adm-btn adm-btn-primary" style="width:100%;">Opprett tenant</button>
					</form>
				</div>

				<div class="adm-card">
					<h3>Importer tenant fra JSON</h3>
					<p class="adm-hint" style="margin-top:0;margin-bottom:0.75rem;">
						Oppretter eller oppdaterer en tenant komplett med farger, domener og logoer fra en <code>*-theme.json</code>-fil.
					</p>
					<form method="post" action="/admin/tenants/import" enctype="multipart/form-data">
						<div class="adm-field" style="margin-bottom:0.75rem;">
							<label for="import-tenant-file">Velg .json-fil</label>
							<input id="import-tenant-file" name="theme_file" type="file" accept=".json,application/json" required/>
						</div>
						<button type="submit" class="adm-btn adm-btn-primary" style="width:100%;">Importer tenant</button>
					</form>
				</div>

				<div class="adm-card">
					<h3>Bytt admin-passord</h3>
					<form method="post" action="/admin/password">
						<div class="adm-field" style="margin-bottom:0.75rem;">
							<label for="new-pw">Nytt passord (min 6 tegn)</label>
							<input id="new-pw" name="new_password" type="password" minlength="6" required/>
						</div>
						<button type="submit" class="adm-btn" style="width:100%;">Oppdater passord</button>
					</form>
				</div>
			</aside>

			<section>
				if flash != "" {
					<div class="adm-alert ok">{ flash }</div>
				}
				if errMsg != "" {
					<div class="adm-alert err">{ errMsg }</div>
				}

				if selected != nil {
					@tenantEditor(*selected, statuses[selected.ID])
				} else {
					<div class="adm-card">
						<p>Velg en tenant fra listen til venstre for å redigere oppsettet.</p>
					</div>
				}
			</section>
		</main>
	}
}

templ tenantEditor(t model.Tenant, st model.TenantStatus) {
	<div class="adm-card">
		<div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:1rem;">
			<div>
				<h2 style="margin-bottom:0.25rem;">{ t.Name } <span class="adm-badge">{ t.Slug }</span></h2>
				<div class="adm-hint">
					Forhåndsvisning uten DNS:
					<a href={ templ.SafeURL("/?tenant=" + t.Slug) } target="_blank">/?tenant={ t.Slug }</a>
					·
					<a href={ templ.SafeURL("/single-room/" + firstRoomAlias(st) + "?tenant=" + t.Slug) } target="_blank">
						/single-room/{ firstRoomAlias(st) }?tenant={ t.Slug }
					</a>
				</div>
			</div>
			<div class="adm-btn-row">
				<form method="post" action={ templ.SafeURL("/admin/tenants/" + idStr(t.ID) + "/sync") } style="margin:0;">
					<button type="submit" class="adm-btn">Test &amp; Synkroniser nå</button>
				</form>
				<form
					method="post"
					action={ templ.SafeURL("/admin/tenants/" + idStr(t.ID) + "/delete") }
					style="margin:0;"
					onsubmit="return confirm('Er du sikker på at du vil slette denne tenanten?');"
				>
					<button type="submit" class="adm-btn adm-btn-danger">Slett tenant</button>
				</form>
			</div>
		</div>

		<div style="margin-top:1rem;padding:0.75rem;border-radius:8px;background:rgba(15,23,42,0.6);border:1px solid var(--adm-border);font-size:0.86rem;">
			<strong>Synkroniseringsstatus:</strong>
			if st.Initialized {
				<span>{ strconv.Itoa(len(st.Rooms)) } rom, { strconv.Itoa(len(st.Roomlists)) } lokasjoner.</span>
				if !st.LastSync.IsZero() {
					<span> Sist oppdatert: { st.LastSync.Format("2006-01-02 15:04:05") }.</span>
				}
			} else {
				<span>Ikke synkronisert ennå.</span>
			}
			if st.LastError != "" {
				<div style="color:#fca5a5;margin-top:0.35rem;">
					<strong>Siste feil:</strong> { st.LastError }
					if st.IsStale {
						<span> (Viser fortsatt siste kjente romdata fra cache.)</span>
					}
				</div>
			}
		</div>

		<div class="adm-section-title">Hurtigvalg for tema-preset</div>
		<div class="adm-btn-row" style="margin-bottom:0.5rem;">
			<form method="post" action={ templ.SafeURL("/admin/tenants/" + idStr(t.ID) + "/preset") } style="margin:0;">
				<input type="hidden" name="preset" value="standard"/>
				<button type="submit" class="adm-btn">Last Standard-tema</button>
			</form>
			<form method="post" action={ templ.SafeURL("/admin/tenants/" + idStr(t.ID) + "/preset") } style="margin:0;">
				<input type="hidden" name="preset" value="compact"/>
				<button type="submit" class="adm-btn">Last Kompakt-tema (norsk 2-kolonne)</button>
			</form>
			<a href={ templ.SafeURL("/admin/tenants/" + idStr(t.ID) + "/theme-export") } class="adm-btn">Eksporter tema (JSON)</a>
			<span class="adm-hint">Preset overskriver farger, layout og etiketter med valgt mal.</span>
		</div>

		<details style="margin:0.75rem 0 0.25rem;padding:0.75rem;border:1px solid var(--adm-border);border-radius:8px;background:rgba(15,23,42,0.4);">
			<summary style="cursor:pointer;font-weight:600;color:var(--adm-accent);">Importer tema fra JSON (inkl. bilder/logoer)</summary>
			<form method="post" action={ templ.SafeURL("/admin/tenants/" + idStr(t.ID) + "/theme-import") } enctype="multipart/form-data" style="margin-top:0.75rem;">
				<div class="adm-form-grid">
					<div class="adm-field">
						<label for="theme_file">Velg .json tema-fil</label>
						<input id="theme_file" name="theme_file" type="file" accept=".json,application/json"/>
					</div>
					<div class="adm-field full">
						<label class="adm-checkbox">
							<input type="checkbox" name="include_metadata" value="1" checked/>
							<span>Oppdater også visningsnavn, domener og standard-status fra JSON</span>
						</label>
					</div>
					<div class="adm-field full">
						<label for="theme_json">Eller lim inn JSON direkte</label>
						<textarea id="theme_json" name="theme_json" placeholder='{"version":1,"theme":{...},"assets":{...}}'></textarea>
					</div>
				</div>
				<div style="margin-top:0.65rem;">
					<button type="submit" class="adm-btn adm-btn-primary">Importer tema</button>
				</div>
			</form>
		</details>

		<form method="post" action={ templ.SafeURL("/admin/tenants/" + idStr(t.ID)) } enctype="multipart/form-data">
			<div class="adm-section-title">1. Generelt &amp; Custom Domains</div>
			<div class="adm-form-grid">
				<div class="adm-field">
					<label for="name">Visningsnavn</label>
					<input id="name" name="name" type="text" value={ t.Name } required/>
				</div>
				<div class="adm-field">
					<label for="slug">Slug (brukes i ?tenant= og asset-URL)</label>
					<input id="slug" name="slug" type="text" value={ t.Slug } required/>
				</div>
				<div class="adm-field full">
					<label for="domains">Custom Domener (kommaseparert, uten protokoll)</label>
					<input id="domains" name="domains" type="text" value={ t.Domains } placeholder="moterom.kunde.no, skjermer.kunde.no"/>
					<span class="adm-hint">Matcher HTTP Host-header automatisk (støtter også *.domene.no).</span>
				</div>
				<div class="adm-field">
					<label for="poll_interval">Polling-intervall (sekunder)</label>
					<input id="poll_interval" name="poll_interval_seconds" type="number" min="10" value={ strconv.Itoa(t.PollIntervalSeconds) }/>
				</div>
				<div class="adm-field">
					<label>&nbsp;</label>
					<label class="adm-checkbox">
						<input type="checkbox" name="is_default" value="1" checked?={ t.IsDefault }/>
						<span>Standard-tenant (fallback hvis ingen domener matcher)</span>
					</label>
				</div>
			</div>

			<div class="adm-section-title">2. Kalender-kilde (Microsoft Graph / Mock)</div>
			<div class="adm-form-grid">
				<div class="adm-field">
					<label for="provider_type">Kalender-provider</label>
					<select id="provider_type" name="provider_type">
						<option value="mock" selected?={ t.ProviderType == "mock" }>Mock / Demo-data (offline-vennlig)</option>
						<option value="msgraph" selected?={ t.ProviderType == "msgraph" }>Microsoft Graph API (M365)</option>
					</select>
				</div>
				<div class="adm-field">
					<label for="privacy_mode">Personvern / Møtetittel</label>
					<select id="privacy_mode" name="privacy_mode">
						<option value="normal" selected?={ t.PrivacyMode == "normal" }>Normal (vis møteemne, skjul kun Private)</option>
						<option value="organizer_as_subject" selected?={ t.PrivacyMode == "organizer_as_subject" }>Kun arrangør (vis arrangør som tittel)</option>
						<option value="hide_subject" selected?={ t.PrivacyMode == "hide_subject" }>Skjul alle emner (vis "Private")</option>
					</select>
				</div>
				<div class="adm-field">
					<label for="oauth_client_id">OAuth Client ID</label>
					<input id="oauth_client_id" name="oauth_client_id" type="text" value={ t.OAuthClientID } placeholder="Azure App Registration Client ID"/>
				</div>
				<div class="adm-field">
					<label for="oauth_authority">OAuth Authority</label>
					<input id="oauth_authority" name="oauth_authority" type="text" value={ t.OAuthAuthority } placeholder="https://login.microsoftonline.com/<tenant-id>"/>
				</div>
				<div class="adm-field">
					<label for="oauth_client_secret">
						OAuth Client Secret
						if t.HasClientSecret {
							<span class="adm-badge ok">Lagret</span>
						}
					</label>
					<input id="oauth_client_secret" name="oauth_client_secret" type="password" placeholder="La stå tom for å beholde eksisterende"/>
				</div>
				<div class="adm-field">
					<label for="exchange_domain">Domene (brukt for Mock / fallback)</label>
					<input id="exchange_domain" name="exchange_domain" type="text" value={ t.ExchangeDomain } placeholder="firma.no"/>
				</div>
			</div>
			<div class="adm-form-grid-3" style="margin-top:0.85rem;">
				<div class="adm-field">
					<label for="max_days">Maks dager frem</label>
					<input id="max_days" name="max_days" type="number" min="1" value={ strconv.Itoa(t.MaxDays) }/>
				</div>
				<div class="adm-field">
					<label for="max_room_lists">Maks romlister</label>
					<input id="max_room_lists" name="max_room_lists" type="number" min="1" value={ strconv.Itoa(t.MaxRoomLists) }/>
				</div>
				<div class="adm-field">
					<label for="max_rooms">Maks rom per liste</label>
					<input id="max_rooms" name="max_rooms" type="number" min="1" value={ strconv.Itoa(t.MaxRooms) }/>
				</div>
			</div>
			<div class="adm-form-grid" style="margin-top:0.85rem;">
				<div class="adm-field">
					<label for="max_items">Maks avtaler per rom</label>
					<input id="max_items" name="max_items" type="number" min="1" value={ strconv.Itoa(t.MaxItems) }/>
				</div>
				<div class="adm-field">
					<label for="room_blacklist">Svartelistede rom (e-post per linje eller komma)</label>
					<textarea id="room_blacklist" name="room_blacklist" style="min-height:68px;">{ t.RoomBlacklist }</textarea>
				</div>
			</div>

			<div class="adm-section-title">3. Layout, Logoer &amp; Bilder</div>
			<div class="adm-form-grid">
				<div class="adm-field">
					<label for="row_layout">Rad-layout på Flightboard</label>
					<select id="row_layout" name="row_layout">
						<option value="standard" selected?={ t.Theme.RowLayout == "standard" }>Standard (Med skjerm-ikon til høyre)</option>
						<option value="compact" selected?={ t.Theme.RowLayout == "compact" }>Kompakt (Klikkbar rad, Nå + Neste i 2 kolonner, stående støtte)</option>
					</select>
				</div>
				<div class="adm-field">
					<label for="single_room_status_size">Enkeltrom status-skriftstørrelse</label>
					<input id="single_room_status_size" name="single_room_status_font_size" type="text" value={ t.Theme.SingleRoomStatusFontSize } placeholder="18vw eller 10vw"/>
				</div>
				<div class="adm-field">
					<label>&nbsp;</label>
					<label class="adm-checkbox">
						<input type="checkbox" name="show_weekday_in_time" value="1" checked?={ t.Theme.ShowWeekdayInTime }/>
						<span>Vis ukedag og dato på tidspunkter i Flightboard</span>
					</label>
				</div>
			</div>

			<div class="adm-form-grid-3" style="margin-top:0.85rem;">
				<div class="adm-field">
					<label for="logo_url">Navbar Logo URL</label>
					<input id="logo_url" name="logo_url" type="text" value={ t.Theme.LogoURL }/>
					<input type="file" name="logo_file" accept="image/*"/>
					if strings.TrimSpace(t.Theme.LogoURL) != "" {
						<img class="adm-asset-preview" src={ t.Theme.LogoURL } alt="Navbar logo preview"/>
					}
				</div>
				<div class="adm-field">
					<label for="footer_image_url">Footer Banner / Slagord URL</label>
					<input id="footer_image_url" name="footer_image_url" type="text" value={ t.Theme.FooterImageURL }/>
					<input type="file" name="footer_file" accept="image/*"/>
					if strings.TrimSpace(t.Theme.FooterImageURL) != "" {
						<img class="adm-asset-preview" src={ t.Theme.FooterImageURL } alt="Footer preview"/>
					}
				</div>
				<div class="adm-field">
					<label for="singleroom_logo_url">Enkeltrom Logo URL</label>
					<input id="singleroom_logo_url" name="single_room_logo_url" type="text" value={ t.Theme.SingleRoomLogoURL }/>
					<input type="file" name="singleroom_logo_file" accept="image/*"/>
					if strings.TrimSpace(t.Theme.SingleRoomLogoURL) != "" {
						<img class="adm-asset-preview" src={ t.Theme.SingleRoomLogoURL } alt="Single room logo preview"/>
					}
				</div>
			</div>

			<div class="adm-section-title">4. Farger</div>
			<div class="adm-form-grid-3">
				@colorField("Bakgrunn", "body_bg", t.Theme.BodyBg)
				@colorField("Kort-bakgrunn", "card_bg", t.Theme.CardBg)
				@colorField("Kort-kantlinje", "card_border", t.Theme.CardBorder)
				@colorField("Topplinje-bakgrunn", "title_bar_bg", t.Theme.TitleBarBg)
				@colorField("Tekstfarge", "primary_font", t.Theme.PrimaryFont)
				@colorField("Ledig (aksent)", "open_color", t.Theme.OpenColor)
				@colorField("Ledig (enkeltrom)", "open_dark_color", t.Theme.OpenDarkColor)
				@colorField("Opptatt", "busy_color", t.Theme.BusyColor)
				@colorField("Neste / Kommende", "upcoming_color", t.Theme.UpcomingColor)
				@colorField("Feil", "error_color", t.Theme.ErrorColor)
			</div>

			<div class="adm-section-title">5. Tekster &amp; Språk</div>
			<div class="adm-form-grid-3">
				<div class="adm-field">
					<label for="label_navbar_title">Tittel i toppmeny</label>
					<input id="label_navbar_title" name="label_navbar_title" type="text" value={ t.Theme.Labels.NavbarTitle }/>
				</div>
				<div class="adm-field">
					<label for="label_filter_title">Filter-meny tittel</label>
					<input id="label_filter_title" name="label_filter_title" type="text" value={ t.Theme.Labels.FilterTitle }/>
				</div>
				<div class="adm-field">
					<label for="label_filter_all">Alle rom-valg</label>
					<input id="label_filter_all" name="label_filter_all_title" type="text" value={ t.Theme.Labels.FilterAllTitle }/>
				</div>
				<div class="adm-field">
					<label for="label_available">Status: Ledig</label>
					<input id="label_available" name="label_status_available" type="text" value={ t.Theme.Labels.StatusAvailable }/>
				</div>
				<div class="adm-field">
					<label for="label_busy">Status: Opptatt</label>
					<input id="label_busy" name="label_status_busy" type="text" value={ t.Theme.Labels.StatusBusy }/>
				</div>
				<div class="adm-field">
					<label for="label_error">Status: Feil</label>
					<input id="label_error" name="label_status_error" type="text" value={ t.Theme.Labels.StatusError }/>
				</div>
				<div class="adm-field">
					<label for="label_now_prefix">Prefiks pågående møte (f.eks. "Nå")</label>
					<input id="label_now_prefix" name="label_now_prefix" type="text" value={ t.Theme.Labels.NowPrefix }/>
				</div>
				<div class="adm-field">
					<label for="label_next_up">Prefiks neste møte (f.eks. "Neste")</label>
					<input id="label_next_up" name="label_next_up" type="text" value={ t.Theme.Labels.NextUp }/>
				</div>
				<div class="adm-field">
					<label for="label_upcoming_title">Enkeltrom overskrift (f.eks. "Kommer")</label>
					<input id="label_upcoming_title" name="label_upcoming_title" type="text" value={ t.Theme.Labels.UpcomingTitle }/>
				</div>
			</div>

			<div class="adm-section-title">6. Custom CSS (Valgfritt)</div>
			<div class="adm-field full">
				<label for="custom_css">Egendefinert CSS for denne tenanten</label>
				<textarea id="custom_css" name="custom_css" placeholder="/* F.eks. .title-bar { border-bottom-width: 2px; } */">{ t.CustomCSS }</textarea>
			</div>

			<div style="margin-top:1.25rem;display:flex;justify-content:flex-end;gap:0.75rem;">
				<button type="submit" class="adm-btn adm-btn-primary">Lagre endringer</button>
			</div>
		</form>
	</div>
	<script>
		(function () {
			var pickers = document.querySelectorAll('.adm-color-picker');
			for (var i = 0; i < pickers.length; i++) {
				(function (picker) {
					var textInput = picker.parentElement.querySelector('input[type="text"]');
					if (!textInput) return;
					picker.addEventListener('input', function () {
						textInput.value = picker.value;
					});
					textInput.addEventListener('input', function () {
						if (/^#[0-9a-fA-F]{6}$/.test(textInput.value.trim())) {
							picker.value = textInput.value.trim();
						}
					});
				})(pickers[i]);
			}
		})();
	</script>
}

templ colorField(label, name, val string) {
	<div class="adm-field">
		<label for={ "color_" + name }>{ label }</label>
		<div class="adm-color-input">
			<input type="color" class="adm-color-picker" value={ normalizeHex(val) } aria-label={ label }/>
			<input id={ "color_" + name } name={ name } type="text" value={ val }/>
		</div>
	</div>
}

func normalizeHex(val string) string {
	v := strings.TrimSpace(val)
	if len(v) == 7 && strings.HasPrefix(v, "#") {
		return v
	}
	if len(v) == 4 && strings.HasPrefix(v, "#") {
		return fmt.Sprintf("#%c%c%c%c%c%c", v[1], v[1], v[2], v[2], v[3], v[3])
	}
	return "#191919"
}

